# Copie este arquivo para .env e preencha com suas proprias credenciais.
# Os valores abaixo sao exemplos; nunca publique seu .env.

# Configuracoes presentes no .env original, mas ainda NAO utilizadas pelo codigo.
# DEBUG: indica a intencao de habilitar depuracao; atualmente nao altera a aplicacao.
DEBUG=false
# API_PREFIX: prefixo pretendido das rotas; atualmente as rotas nao usam este valor.
API_PREFIX=/api
# ALLOW_ORIGINS: origens pretendidas para CORS; atualmente o CORS esta fixo em app/main.py.
ALLOW_ORIGINS=http://localhost:8000

# Chave da API Google Gemini, usada pelos modelos de linguagem e embeddings.
GEMINI_API_KEY=

# Conexao PostgreSQL, usada para consultar e registrar transacoes financeiras.
# Substitua usuario, senha, host, porta e nome do banco conforme seu ambiente.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/seu_banco

# Chave da API Groq, usada pelo roteamento, resumo e outros agentes.
GROQ_API_KEY=

# Conexao MongoDB, usada para sessoes, mensagens e perfis.
# O codigo seleciona explicitamente o banco assessor.
MONGODB_URI=mongodb://localhost:27017/assessor

# Chave de acesso ao Qdrant; a validacao atual exige que seja preenchida.
QDRANT_API_KEY=

# URL do cluster Qdrant, usado nas buscas vetoriais de FAQ, memoria e restricoes.
QDRANT_CLUSTER_ENDPOINT=https://seu-cluster.qdrant.io
